;;; notation-server.el --- Browse notation notes as a graph in a web browser -*- lexical-binding: t; -*-

;; Author: You
;; Version: 0.2.1
;; Package-Requires: ((emacs "27.1") (notation "0.3.2"))
;; Keywords: outlines, hypermedia

;;; Commentary:
;;
;; Emacs side of notation-server, the FastAPI app in this same
;; repository. The server shows every note under `notation-directory' as
;; a node in a graph, with "notation:ID" links as edges, and renders the
;; clicked note (Org via pandoc, PDFs inline).
;;
;; This is an experimental companion to notation.el, in its own
;; repository so the core package never depends on it. Nothing here
;; changes notation's behaviour; it only reads `notation-directory' and
;; two of notation's helpers.
;;
;; By default the server is run from this repository's checkout with
;; "uv run --project"; see `notation-server-command' to use an installed
;; "notation-server" command instead.
;;
;;   M-x notation-server-start        run the server as a subprocess
;;   M-x notation-server-stop
;;   M-x notation-server-browse       show the current note in the browser
;;   M-x notation-server-follow-mode  keep the graph on whatever note you visit
;;
;; Emacs -> browser: `notation-server-browse' asks the server to re-centre
;; any already-open tab on the current note, and only opens a new tab when
;; none is listening.
;;
;; Browser -> Emacs: the server's "Edit in Emacs" button runs
;; "emacsclient -n FILE", which needs the Emacs server running (see
;; `server-start').
;;
;; Requests that change state (focus, edit) need a per-launch token.
;; `notation-server-start' generates one and passes it to the server. If
;; you start the server yourself, set `notation-server-token' to the token
;; it prints, or export NOTATION_SERVER_TOKEN for both.

;;; Code:

(require 'notation)
(require 'url)
(require 'json)

(defvar url-http-end-of-headers)
(defvar server-process)

(defgroup notation-server nil
  "Browse notation notes as a graph in a web browser."
  :group 'notation
  :prefix "notation-server-")

(defconst notation-server--source-dir
  (file-name-directory (or load-file-name buffer-file-name))
  "Root of the notation-server repository: this file and the Python project.")

(defcustom notation-server-host "127.0.0.1"
  "Host the server listens on and is contacted at."
  :type 'string
  :group 'notation-server)

(defcustom notation-server-port 8765
  "Port the server listens on and is contacted at."
  :type 'integer
  :group 'notation-server)

(defcustom notation-server-command
  (list "uv" "run" "--project" notation-server--source-dir "notation-server")
  "Command list that launches the server.
`notation-server-start' appends --dir, --host, --port, your
`org-todo-keywords' and the emacsclient options to it. The default
runs the server from this repository's checkout. After \"uv tool
install <this repo>\", set it to
\\='(\"notation-server\") to use the installed command instead."
  :type '(repeat string)
  :group 'notation-server)

(defcustom notation-server-token nil
  "Token for a server not started by `notation-server-start'.
Leave nil when using `notation-server-start', which makes its own."
  :type '(choice (const :tag "Generated at start" nil) string)
  :group 'notation-server)

(defcustom notation-server-follow-delay 0.5
  "Idle seconds before `notation-server-follow-mode' re-centres the graph."
  :type 'number
  :group 'notation-server)

(defvar notation-server--process nil
  "The server subprocess started by `notation-server-start', if any.")

(defvar notation-server--token nil
  "Token generated by the last `notation-server-start'.")

;;; Helpers

(defun notation-server--url (&optional path)
  "Return the server URL for PATH (default \"/\")."
  (format "http://%s:%d%s" notation-server-host notation-server-port (or path "/")))

(defun notation-server--token ()
  "Return the token for state-changing requests, or nil if unknown."
  (or notation-server--token
      notation-server-token
      (getenv "NOTATION_SERVER_TOKEN")))

(defun notation-server--new-token ()
  "Return a fresh random token."
  (random t)
  (secure-hash 'sha256 (format "%s %s %s %s" (random) (random) (emacs-pid) (current-time))))

(defun notation-server--current-id ()
  "Return the id of the note visited in the current buffer, or nil."
  (let ((file (buffer-file-name)))
    (and file
         (notation--note-file-p file)
         (notation--id-from-file file))))

(defun notation-server--emacsclient ()
  "Return the emacsclient belonging to this Emacs, or the one on PATH."
  (let ((own (expand-file-name "emacsclient" invocation-directory)))
    (if (file-executable-p own) own (executable-find "emacsclient"))))

(defvar org-todo-keywords)

(defun notation-server--todo-sequences ()
  "Return `org-todo-keywords' as \"#+TODO:\" line values.
Fast-access keys and logging options such as \"(t)\" or \"(w@/!)\"
are dropped. Loads Org, so that settings made in its load hooks
\(e.g. Doom's `after!') are included."
  (require 'org)
  (let ((sequences (if (stringp (car org-todo-keywords))
                       ;; The old format: one plain list of keywords.
                       (list (cons 'sequence org-todo-keywords))
                     org-todo-keywords)))
    (mapcar (lambda (seq)
              (mapconcat (lambda (kw) (replace-regexp-in-string "(.*)\\'" "" kw))
                         (cdr seq) " "))
            sequences)))

(defun notation-server--post (path payload callback)
  "POST PAYLOAD as JSON to PATH asynchronously.
CALLBACK is called with (REPLY ERROR): REPLY is the parsed JSON reply
as an alist, or nil; ERROR is url.el's error descriptor, or nil."
  (let ((token (notation-server--token)))
    (if (not token)
        (funcall callback nil '(error no-token))
      (let ((url-request-method "POST")
            (url-request-extra-headers
             `(("Content-Type" . "application/json")
               ("X-Notation-Token" . ,token)))
            (url-request-data (encode-coding-string (json-encode payload) 'utf-8)))
        (condition-case err
            (url-retrieve
             (notation-server--url path)
             (lambda (status)
               (let* ((error (plist-get status :error))
                      (reply (and (not error)
                                  (boundp 'url-http-end-of-headers)
                                  url-http-end-of-headers
                                  (progn
                                    (goto-char url-http-end-of-headers)
                                    (let ((json-object-type 'alist))
                                      (ignore-errors (json-read)))))))
                 (kill-buffer (current-buffer))
                 (funcall callback reply error)))
             nil t t)
          (error (funcall callback nil err)))))))

(defun notation-server--http-error-p (error)
  "Return non-nil if ERROR means the server answered, with an HTTP error."
  (eq (cadr error) 'http))

;;; Server process

(defun notation-server--sentinel (proc event)
  "Report the server PROC exiting with EVENT."
  (unless (process-live-p proc)
    (setq notation-server--process nil
          notation-server--token nil)
    (message "notation-server: %s (see *notation-server*)" (string-trim event))))

;;;###autoload
(defun notation-server-start ()
  "Start notation-server on `notation-directory' as a subprocess."
  (interactive)
  (if (process-live-p notation-server--process)
      (message "notation-server is already running at %s" (notation-server--url))
    (let* ((token (notation-server--new-token))
           (emacsclient (notation-server--emacsclient))
           (process-environment
            (cons (concat "NOTATION_SERVER_TOKEN=" token) process-environment))
           (command
            (append notation-server-command
                    (list "--dir" (expand-file-name notation-directory)
                          "--host" notation-server-host
                          "--port" (number-to-string notation-server-port))
                    (mapcan (lambda (seq) (list "--todo-keywords" seq))
                            (notation-server--todo-sequences))
                    (if emacsclient
                        (list "--emacsclient" emacsclient)
                      (list "--no-emacs")))))
      (unless (and (boundp 'server-process) (process-live-p server-process))
        (message "notation-server: the Emacs server isn't running, so \"Edit in Emacs\" won't work until M-x server-start"))
      (setq notation-server--token token
            notation-server--process
            (make-process :name "notation-server"
                          :buffer (get-buffer-create "*notation-server*")
                          :command command
                          :noquery t
                          :sentinel #'notation-server--sentinel))
      (add-hook 'kill-emacs-hook #'notation-server-stop)
      (message "notation-server starting at %s" (notation-server--url)))))

;;;###autoload
(defun notation-server-stop ()
  "Stop the server started by `notation-server-start'."
  (interactive)
  (when (process-live-p notation-server--process)
    ;; SIGINT lets uvicorn (via uv, which forwards it) shut down cleanly.
    (interrupt-process notation-server--process)))

;;; Emacs -> browser

;;;###autoload
(defun notation-server-browse ()
  "Show the current buffer's note in the browser, or the whole graph.
An open graph tab re-centres on the note; a new tab is opened only if
no tab is listening."
  (interactive)
  (let ((id (notation-server--current-id)))
    (if (not id)
        (browse-url (notation-server--url "/"))
      (notation-server--post
       "/api/focus" `((id . ,id))
       (lambda (reply error)
         (cond
          ((and reply (> (or (alist-get 'listeners reply) 0) 0))
           (message "notation-server: showing %s" id))
          ((or reply (notation-server--http-error-p error)
               (equal error '(error no-token)))
           (browse-url (notation-server--url (format "/note/%s" id))))
          (t
           (message "notation-server isn't reachable at %s; try M-x notation-server-start"
                    (notation-server--url)))))))))

(defvar notation-server--follow-timer nil)
(defvar notation-server--last-focused nil)

(defun notation-server--schedule-focus (&rest _)
  "Re-centre the graph on the selected note once Emacs is idle."
  (when (timerp notation-server--follow-timer)
    (cancel-timer notation-server--follow-timer))
  (setq notation-server--follow-timer
        (run-with-idle-timer notation-server-follow-delay nil
                             #'notation-server--follow-focus)))

(defun notation-server--follow-focus ()
  "Send the selected window's note to the server, if it changed."
  (let ((id (with-current-buffer (window-buffer (selected-window))
              (notation-server--current-id))))
    (when (and id (not (equal id notation-server--last-focused)))
      (setq notation-server--last-focused id)
      (notation-server--post "/api/focus" `((id . ,id)) #'ignore))))

;;;###autoload
(define-minor-mode notation-server-follow-mode
  "Keep the browser graph centred on the note in the selected window."
  :global t
  :group 'notation-server
  (if notation-server-follow-mode
      (progn
        (setq notation-server--last-focused nil)
        (add-hook 'window-buffer-change-functions #'notation-server--schedule-focus)
        (add-hook 'window-selection-change-functions #'notation-server--schedule-focus))
    (remove-hook 'window-buffer-change-functions #'notation-server--schedule-focus)
    (remove-hook 'window-selection-change-functions #'notation-server--schedule-focus)))

(provide 'notation-server)
;;; notation-server.el ends here
